<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No permissions. In particular, no INTERNET. Also drop the one androidx.core adds. -->
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hasFragileUserData="false"
        android:icon="@drawable/ic_dictionary"
        android:roundIcon="@drawable/ic_dictionary"
        android:label="@string/label_dictionary"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <!-- The real activity. Not a launcher itself; each disguise is an activity-alias below.
             Exactly one alias is enabled at a time, so only one icon and name ever show. The
             enabled one here is the direct edition's default face (the reference app); the play
             edition's manifest (src/play) swaps in its own undisguised face. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".FaceDictionary"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@drawable/ic_dictionary"
            android:roundIcon="@drawable/ic_dictionary"
            android:label="@string/label_dictionary">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>





        <!-- After an update, moves an install whose face was removed in 1.5 (Calculator, Notes,
             Clock, Sudoku) to the default face (see UpdateReceiver). Not exported: the system
             delivers this broadcast to the app itself. -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Exported by a library; not needed, and nothing but the launcher should be exported. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove" />
    </application>
</manifest>
